{
  "name": "nadi-gati",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "emulators:start": "firebase emulators:start",
    "emulators:firestore": "firebase emulators:start --only firestore",
    "clean": "next clean",
    "postinstall": "node -e \"const fs=require('fs');const src='node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs';if(fs.existsSync(src)){fs.copyFileSync(src,'public/maplibre-gl-worker.mjs')}else{console.warn('[postinstall] maplibre-gl worker not found; the report map will show an error until public/maplibre-gl-worker.mjs exists')}\"",
    "test:rules": "firebase emulators:exec --only firestore,storage \"node --test tests/*.test.ts\""
  },
  "dependencies": {
    "@serwist/next": "^9.5.12",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "geofire-common": "^6.0.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.553.0",
    "maplibre-gl": "^6.9.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.10.1",
    "serwist": "^9.5.12"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "4.1.11",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}

# Copy to .env.local and fill in what you need. Every variable is optional unless marked required.

# --- Website (Next.js) ---------------------------------------------------------------------------
# Firebase web config is read from firebase-applet-config.json. These override it if set.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Named Firestore database, if not "(default)"
NEXT_PUBLIC_FIREBASE_DATABASE_ID=""
# Web Push VAPID public key. Required for alert subscriptions to work.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
# Set to "true" to use the local Firebase emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=""
NEXT_PUBLIC_CONNECT_EMULATORS=""

# Server routes (Firebase Admin SDK)
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_DATABASE_ID=""
# Service account JSON on one line. Without it, Application Default Credentials are used.
FIREBASE_SERVICE_ACCOUNT_KEY=""


# --- Cloud Functions -----------------------------------------------------------------------------
# API keys are Secret Manager secrets, NOT env vars. Set them with:
#   firebase functions:secrets:set OPENWEATHER_API_KEY
#   firebase functions:secrets:set DATA_GOV_IN_API_KEY
#   firebase functions:secrets:set SEED_TOKEN
# Putting them in functions/.env would deploy them as plain-text environment variables.
# OpenWeatherMap rainfall ingestion is skipped without OPENWEATHER_API_KEY; data.gov.in ingestion is
# skipped unless both DATA_GOV_IN_API_KEY and DATA_GOV_RESOURCE_ID are set.
#
# DATA_GOV_RESOURCE_ID is not secret: put it in functions/.env as DATA_GOV_RESOURCE_ID="..."
# (a river water-level dataset with station_name and water_level fields).
DATA_GOV_RESOURCE_ID=""
